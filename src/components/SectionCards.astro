---
interface Props {
  title?: string;
}
const { title = 'Направления лаборатории' } = Astro.props;

const directions = [
  {
    href: '/system/',
    tag: 'Система',
    title: 'UI Kit, дизайн-токены, архитектуры',
    text: 'Дизайн-токены AltaiR, сравнение архитектур, темы и UI Kit: как устроена системная часть студии.',
  },
  {
    href: '/engineering/',
    tag: 'Инженерия',
    title: 'Скорость, PageSpeed, Core Web Vitals',
    text: 'Разборы производительности: PageSpeed 100/100, Core Web Vitals, загрузка ~0.4 с без компромиссов.',
  },
  {
    href: '/cases/',
    tag: 'Кейсы-разборы',
    title: 'Технические постмортемы',
    text: 'Честные разборы сложных производственных задач: что пошло не так, как чинили и что вынесли.',
  },
  {
    href: '/modules/',
    tag: 'Модули платформы',
    title: 'MOD 01, Telegram-лиды, калькуляторы',
    text: 'Как устроены модули платформы AltaiR и как они собираются в продакшен-сценарии.',
  },
  {
    href: '/playbook/',
    tag: 'Playbook',
    title: 'Процессы, сметы, чеклисты',
    text: 'Стандарты качества, процессы оценки, декомпозиция смет — как студия работает «на бумаге».',
  },
];
---

<section class="home-section" aria-labelledby="directions-heading">
  <h2 id="directions-heading" class="home-section-title">{title}</h2>
  <div class="directions-grid">
    {
      directions.map((d) => (
        <a class="direction-card" href={d.href}>
          <span class="direction-tag">{d.tag}</span>
          <h3>{d.title}</h3>
          <p>{d.text}</p>
          <span class="direction-link">Перейти в раздел →</span>
        </a>
      ))
    }
  </div>
</section>

<style>
  .home-section {
    margin: 3rem 0 1rem;
  }
  .home-section-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }
  .directions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .direction-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
  }
  .direction-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }
  .direction-card h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .direction-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sl-color-text-muted);
  }
  .direction-link {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: #60a5fa;
  }
  @media (max-width: 50rem) {
    .directions-grid {
      grid-template-columns: 1fr;
    }
  }
</style>