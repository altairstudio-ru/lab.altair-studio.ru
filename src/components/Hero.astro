---
// AltaiR Lab — hero инженерного журнала (override Starlight Hero).
// Blueprint-сетка, айтрекер-строка, акцентные действия.
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="lab-hero">
	<div class="lab-hero__inner">
		<div class="lab-hero__meta">
			<span class="lab-hero__meta-line">//</span>
			<span class="lab-hero__meta-item">инженерный журнал</span>
			<span class="lab-hero__meta-sep"></span>
			<span class="lab-hero__meta-item">AltaiR Lab</span>
		</div>

		<div class="lab-hero__copy">
			<h1 id="_top" data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="lab-hero__tagline" set:html={tagline} />}
		</div>

		{
			actions.length > 0 && (
				<div class="lab-hero__actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
							<a
								href={href}
								class:list={[
									'lab-hero__btn',
									variant === 'primary' ? 'lab-hero__btn--primary' : 'lab-hero__btn--secondary',
									className,
								]}
								{...attrs}
							>
								{text}
							</a>
						)
					)}
				</div>
			)
		}
	</div>
</div>

<style>
	.lab-hero {
		position: relative;
		padding-block: clamp(2.5rem, calc(2rem + 6vmin), 6rem) 2.5rem;
		border-radius: 14px;
		overflow: hidden;
	}

	/* Blueprint-сетка внутри hero с маской растворения */
	.lab-hero::before {
		content: '';
		position: absolute;
		inset: -2px;
		z-index: 0;
		pointer-events: none;
		background-image:
			linear-gradient(rgba(148, 163, 184, 0.09) 1px, transparent 1px),
			linear-gradient(90deg, rgba(148, 163, 184, 0.09) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: radial-gradient(ellipse 90% 90% at 50% 10%, #000 25%, transparent 75%);
		-webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 10%, #000 25%, transparent 75%);
	}

	.lab-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(42rem 24rem at 85% 10%, rgba(59, 130, 246, 0.14), transparent 65%),
			radial-gradient(30rem 20rem at 5% 100%, rgba(56, 189, 248, 0.09), transparent 65%);
	}

	.lab-hero__inner {
		position: relative;
		z-index: 1;
		max-width: 62rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.lab-hero__meta {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #38bdf8;
	}

	.lab-hero__meta-line {
		color: #3b82f6;
	}

	.lab-hero__meta-sep {
		width: 2.5rem;
		height: 1px;
		background: linear-gradient(90deg, #3b82f6, transparent);
	}

	.lab-hero__copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 44rem;
	}

	.lab-hero__copy h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 4.5vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
	}

	.lab-hero__tagline {
		font-size: clamp(1rem, calc(0.5rem + 1vw), 1.2rem);
		line-height: 1.65;
		color: var(--sl-color-gray-2);
		max-width: 46ch;
	}

	.lab-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 0.5rem;
	}

	.lab-hero__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 10px;
		padding: 0.7rem 1.25rem;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
	}

	.lab-hero__btn--primary {
		background: linear-gradient(135deg, #3b82f6 0%, #38bdf8 100%);
		color: #0f172a;
		border: 1px solid transparent;
	}

	.lab-hero__btn--primary:hover {
		transform: translateY(-1px);
		filter: brightness(1.06);
	}

	.lab-hero__btn--secondary {
		color: var(--sl-color-text);
		border: 1px solid #334155;
		background: rgba(30, 41, 59, 0.35);
	}

	.lab-hero__btn--secondary:hover {
		border-color: #3b82f6;
		transform: translateY(-1px);
	}
</style>