---
// AltaiR Lab — hero инженерного журнала (override Starlight Hero).
// Канон: тема «Modern Tech» основного сайта — чип-бейдж с пульсатором,
// монументальный extrabold-заголовок, метрики-постамент, Digital Blue без градиентов.
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const metrics = [
	{ value: '5', chip: 'колонок', desc: 'контентных направлений журнала' },
	{ value: '100/100', chip: 'PageSpeed', desc: 'Google PageSpeed на смартфонах' },
	{ value: '0.4 с', chip: 'загрузка', desc: 'быстрые страницы без компромиссов' },
	{ value: '1–2', chip: 'недели', desc: 'ритм публикаций lab' },
];
---

<div class="lab-hero">
	<div class="lab-hero__inner">
		<div class="lab-hero__badge">
			<span class="lab-hero__badge-dot"></span>
			<span class="lab-hero__badge-part">AltaiR Lab</span>
			<span class="lab-hero__badge-sep">/</span>
			<span class="lab-hero__badge-part lab-hero__badge-part--accent">инженерный журнал студии</span>
		</div>

		<div class="lab-hero__copy">
			<h1 id="_top" data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="lab-hero__tagline" set:html={tagline} />}
		</div>

		{
			actions.length > 0 && (
				<div class="lab-hero__actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
							<a
								href={href}
								class:list={[
									'lab-hero__btn',
									variant === 'primary' ? 'lab-hero__btn--primary' : 'lab-hero__btn--secondary',
									className,
								]}
								{...attrs}
							>
								{text}
							</a>
						)
					)}
				</div>
			)
		}
	</div>

	<div class="lab-hero__metrics">
		{
			metrics.map((m) => (
				<div class="lab-hero__metric">
					<span class="lab-hero__metric-value">{m.value}</span>
					<span class="lab-hero__metric-chip">{m.chip}</span>
					<span class="lab-hero__metric-desc">{m.desc}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.lab-hero {
		position: relative;
		padding-block: clamp(2.5rem, calc(2rem + 6vmin), 6rem) 2.5rem;
		overflow: hidden;
	}

	/* Hero: glow-свечения (сетку даёт main::before, чтобы не было муара) */
	.lab-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(42rem 24rem at 85% 10%, rgba(59, 130, 246, 0.12), transparent 65%),
			radial-gradient(30rem 20rem at 5% 100%, rgba(59, 130, 246, 0.06), transparent 65%);
	}

	.lab-hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* Чип-бейдж как на каноническом сайте */
	.lab-hero__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		width: fit-content;
		padding: 0.45rem 0.9rem;
		border-radius: 999px;
		background: #1e293b;
		border: 1px solid #334155;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #cbd5e1;
	}

	.lab-hero__badge-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #3b82f6;
		animation: lab-pulse 1.6s ease-in-out infinite;
	}

	@keyframes lab-pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.35; }
	}

	.lab-hero__badge-part {
		font-weight: 700;
		color: #ffffff;
	}

	.lab-hero__badge-part--accent {
		color: #60a5fa;
		font-weight: 600;
	}

	.lab-hero__badge-sep {
		color: #475569;
	}

	.lab-hero__copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 46rem;
	}

	.lab-hero__copy h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-4xl), calc(0.25rem + 4.5vw), var(--sl-text-6xl));
		line-height: 1.12;
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}

	.lab-hero__tagline {
		font-size: clamp(1rem, calc(0.5rem + 1vw), 1.2rem);
		line-height: 1.65;
		color: var(--sl-color-gray-3);
		max-width: 52ch;
	}

	.lab-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1rem;
		margin-top: 0.5rem;
	}

	.lab-hero__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 6px;
		padding: 0.7rem 1.25rem;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
	}

	.lab-hero__btn--primary {
		background: #3b82f6;
		color: #ffffff;
		border: 1px solid #3b82f6;
	}

	.lab-hero__btn--primary:hover {
		background: #60a5fa;
		border-color: #60a5fa;
		transform: translateY(-1px);
	}

	.lab-hero__btn--secondary {
		color: var(--sl-color-text);
		border: 1px solid #334155;
		background: rgba(30, 41, 59, 0.35);
	}

	.lab-hero__btn--secondary:hover {
		border-color: #3b82f6;
		transform: translateY(-1px);
	}

	/* Метрики-постамент (канонический блок 4×: моноцифры + чипы) */
	.lab-hero__metrics {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0 1.5rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid #334155;
	}

	.lab-hero__metric {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-right: 1.5rem;
	}

	.lab-hero__metric + .lab-hero__metric {
		border-left: 1px solid #1e293b;
		padding-left: 1.5rem;
		padding-right: 0;
	}

	.lab-hero__metric-value {
		font-family: var(--sl-font-mono);
		font-size: clamp(1.6rem, calc(0.5rem + 1.6vw), 2.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		color: var(--sl-color-white);
	}

	.lab-hero__metric-chip {
		width: fit-content;
		padding: 0.12rem 0.5rem;
		border-radius: 6px;
		background: rgba(59, 130, 246, 0.12);
		border: 1px solid rgba(59, 130, 246, 0.35);
		font-family: var(--sl-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #60a5fa;
	}

	.lab-hero__metric-desc {
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--sl-color-gray-3);
		max-width: 22ch;
	}

	@media (max-width: 54rem) {
		.lab-hero__metrics {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.25rem 1.5rem;
		}
		.lab-hero__metric:nth-child(3) {
			border-left: none;
			padding-left: 0;
		}
	}

	@media (max-width: 30rem) {
		.lab-hero__metric + .lab-hero__metric,
		.lab-hero__metric:nth-child(3) {
			border-left: none;
			padding-left: 0;
		}
	}
</style>